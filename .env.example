# Public HTTPS URL that Twilio can reach, e.g. from `ngrok http 8000`
PUBLIC_URL=https://example.ngrok-free.app

# Twilio (works on a trial account: calls must go to verified numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+44...

# ElevenLabs: a text-only agent writes the replies, and text-to-speech speaks them.
ELEVENLABS_API_KEY=
# Run scripts/setup_agent.py to create the agent and get this id
ELEVENLABS_AGENT_ID=
# Optional: defaults to "George", a British premade voice
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Optional: Gemini classifies hold audio more reliably. Without it, keyword rules are used.
GEMINI_API_KEY=
# Current Gemini Flash model; override with another supported Gemini model if needed.
GEMINI_MODEL=gemini-3.8-flash
# Set true only with fake data; includes receptionist and agent text in session events.
SHOW_TRANSCRIPTS=false

# Test safety: while enabled, calls and SMS are limited to this E.164 allowlist.
TEST_MODE=true
ALLOWED_DESTINATIONS=
# API key required by the patient-facing API routes.
APP_API_KEY=
# Maximum new calls accepted in one hour; set 0 for no limit.
MAX_CALLS_PER_HOUR=3
# Optional validation of X-Twilio-Signature on webhook requests.
TWILIO_VALIDATE_SIGNATURES=false

# Twilio trial accounts end a call after 10 <Gather>/<Redirect> callbacks.
# Set MAX_HOPS=0 on a paid account.
MAX_HOPS=10
# Twilio waits 5s for each reply on trial; the agent gives up at this point and asks again.
REPLY_TIMEOUT_SECONDS=3.8
