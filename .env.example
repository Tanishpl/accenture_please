# Public HTTPS URL that Twilio can reach, e.g. from `ngrok http 8000`
PUBLIC_URL=https://example.ngrok-free.app

# Twilio (a UK number that can call UK landlines)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+44...

# ElevenLabs: run scripts/setup_agent.py to get the agent id
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional: a British English voice from the voice library
ELEVENLABS_VOICE_ID=

# Live transcription while on hold (without it, use the "Receptionist answered" button)
DEEPGRAM_API_KEY=

# Hold-phase classifier. Without credentials it falls back to keyword rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

MAX_HOLD_MINUTES=90
